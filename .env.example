# One side of every comparison — required
LLMAPI_API_KEY=
# Defaults to https://api.llmapi.ai/v1
#LLMAPI_BASE_URL=https://api.llmapi.ai/v1

# Direct provider key — required
OPENAI_API_KEY=

# Optional: the gateway billing pipeline's ClickHouse. When set, the "$ billed"
# column is resolved from the `log` table by request id and checked against the
# response's cost_usd_* (billing parity). Unset → column stays empty.
#CLICKHOUSE_URL=http://localhost:18123
#CLICKHOUSE_DATABASE=llmgateway
